# =====================================================
# LAWTRIX Backend Environment Variables
# =====================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys and credentials
# 3. NEVER commit .env to git!
# =====================================================

# ── LLM Provider API Keys ──────────────────────────────
# Get your API keys from:
# - Sarvam AI: https://sarvam.ai (required for voice features)
# - Google AI Studio: https://makersuite.google.com/app/apikey
# - Mistral: https://console.mistral.ai/
# - OpenRouter: https://openrouter.ai/keys

SARVAM_API_KEY=your_sarvam_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── LLM Configuration ──────────────────────────────────
# Provider priority (first available wins)
LLM_PRIORITY=gemini,mistral,openrouter,ollama,sarvam

# Model overrides (optional)
# GEMINI_MODEL=gemini-2.0-flash
# MISTRAL_MODEL=mistral-small-latest
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free
# OLLAMA_MODEL=phi3
# SARVAM_LLM_MODEL=sarvam-m

# ── Ollama Configuration (local LLM) ───────────────────
# Only needed if using Ollama
# OLLAMA_BASE_URL=http://localhost:11434

# ── LLM Parameters ─────────────────────────────────────
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1024

# ── Database Configuration ─────────────────────────────
# PostgreSQL connection string
# DATABASE_URL=postgresql://user:password@localhost:5432/lawtrix

# ── Redis Configuration (for rate limiting) ────────────
# REDIS_URL=redis://localhost:6379/0

# ── CORS Configuration ─────────────────────────────────
# PRODUCTION: Set to your actual frontend domains
# DEVELOPMENT: Can use * for local testing
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Notification Services ──────────────────────────────
# Twilio (SMS)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# MSG91 (India SMS alternative)
# MSG91_AUTH_KEY=your_msg91_key
# MSG91_SENDER_ID=LAWTRIX

# SendGrid (Email)
# SENDGRID_API_KEY=your_sendgrid_key
# EMAIL_FROM=noreply@lawtrix.app

# SMTP (Email alternative)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# ── Vector Store & Embeddings ──────────────────────────
# CHROMA_PERSIST_DIR=./chromadb
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Application Configuration ──────────────────────────
# PORT=8000
# LOG_LEVEL=INFO
# ENVIRONMENT=production

# ── Security ───────────────────────────────────────────
# JWT_SECRET=your_very_long_random_secret_key_here
# SESSION_SECRET=another_long_random_secret
